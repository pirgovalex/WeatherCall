# Base URL of the API. Leave empty to use the same origin (the Vite proxy in development).
VITE_API_BASE_URL=
# Set to 1 to serve mock data from the contract fixtures instead of calling the backend.
VITE_USE_MOCKS=
# Development proxy target for /api and /healthz.
DEV_API_TARGET=http://127.0.0.1:8000
